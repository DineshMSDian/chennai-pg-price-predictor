# multi stage dicker for frontend (streamlit)
# stage 1: builder

FROM python:3.12-slim AS builder

WORKDIR /web-builder
COPY pyproject.toml uv.lock ./

RUN pip install uv
RUN uv sync --frozen --no-dev --group web --no-install-project

# stage 2: runtime

FROM python:3.12-slim

WORKDIR /web-runtime

COPY --from=builder /web-builder/.venv /web-runtime/.venv
COPY web/ ./web/

ENV PATH="/web-runtime/.venv/bin:$PATH"

EXPOSE 8501

CMD [ "python", "-m", "streamlit", "run", "web/app.py", "--server.address=0.0.0.0", "--server.port=8501"]